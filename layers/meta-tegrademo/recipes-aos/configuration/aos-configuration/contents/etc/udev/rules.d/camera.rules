# Stable AOS camera names for UVC capture nodes.
#
# The exact ID_PATH_TAG strings changed across JetPack/Yocto releases, so match
# the USB hub port structure with wildcards instead of pinning the full tag.
# Path-specific rules win; kernel-number fallbacks are only for unknown-but-valid
# UVC capture topology.

ACTION!="add", GOTO="aos_camera_end"
SUBSYSTEM!="video4linux", GOTO="aos_camera_end"
KERNEL!="video*", GOTO="aos_camera_end"
ENV{ID_V4L_CAPABILITIES}!="*:capture:*", GOTO="aos_camera_end"

# Upper/lower hub port layouts seen on the Orin carrier.
ENV{ID_PATH_TAG}=="*usb-0_2_1*", SYMLINK+="videoa", OPTIONS+="link_priority=100", GOTO="aos_camera_end"
ENV{ID_PATH_TAG}=="*usb-0_2_2*", SYMLINK+="videob", OPTIONS+="link_priority=100", GOTO="aos_camera_end"
ENV{ID_PATH_TAG}=="*usb-0_2_3*", SYMLINK+="videoc", OPTIONS+="link_priority=100", GOTO="aos_camera_end"
ENV{ID_PATH_TAG}=="*usb-0_2_4*", SYMLINK+="videod", OPTIONS+="link_priority=100", GOTO="aos_camera_end"

ENV{ID_PATH_TAG}=="*usb-0_1_1*", SYMLINK+="videoa", OPTIONS+="link_priority=100", GOTO="aos_camera_end"
ENV{ID_PATH_TAG}=="*usb-0_1_2*", SYMLINK+="videob", OPTIONS+="link_priority=100", GOTO="aos_camera_end"
ENV{ID_PATH_TAG}=="*usb-0_1_3*", SYMLINK+="videoc", OPTIONS+="link_priority=100", GOTO="aos_camera_end"
ENV{ID_PATH_TAG}=="*usb-0_1_4*", SYMLINK+="videod", OPTIONS+="link_priority=100", GOTO="aos_camera_end"

# Fallback for four UVC cameras when the USB path tag is not one of the known
# carrier paths. UVC metadata nodes usually occupy odd video numbers, so the
# capture devices are normally video0/video2/video4/video6.
KERNEL=="video0", SYMLINK+="videoa"
KERNEL=="video2", SYMLINK+="videob"
KERNEL=="video4", SYMLINK+="videoc"
KERNEL=="video6", SYMLINK+="videod"

LABEL="aos_camera_end"
