# Stable AOS camera names for UVC capture nodes.
#
# The exact ID_PATH_TAG strings changed across JetPack/Yocto releases, so match
# the USB hub port structure with wildcards instead of pinning the full tag.
# Match complete port/interface suffixes so port 1 cannot also match port 10
# or a camera behind another hub. AOS binds calibration to these aliases, so
# enumeration order must never determine the camera name.

ACTION!="add|change", GOTO="aos_camera_end"
SUBSYSTEM!="video4linux", GOTO="aos_camera_end"
KERNEL!="video*", GOTO="aos_camera_end"
DRIVERS=="uvcvideo", GOTO="aos_uvc_camera"
GOTO="aos_camera_end"

LABEL="aos_uvc_camera"
ATTR{index}!="0", GOTO="aos_camera_end"
ENV{ID_V4L_CAPABILITIES}!="*:capture:*", GOTO="aos_camera_end"

# Upper/lower hub port layouts seen on the Orin carrier.
ENV{ID_PATH_TAG}=="*usb-0_2_1_1_0", SYMLINK+="videoa", GOTO="aos_camera_end"
ENV{ID_PATH_TAG}=="*usb-0_2_2_1_0", SYMLINK+="videob", GOTO="aos_camera_end"
ENV{ID_PATH_TAG}=="*usb-0_2_3_1_0", SYMLINK+="videoc", GOTO="aos_camera_end"
ENV{ID_PATH_TAG}=="*usb-0_2_4_1_0", SYMLINK+="videod", GOTO="aos_camera_end"

ENV{ID_PATH_TAG}=="*usb-0_1_1_1_0", SYMLINK+="videoa", GOTO="aos_camera_end"
ENV{ID_PATH_TAG}=="*usb-0_1_2_1_0", SYMLINK+="videob", GOTO="aos_camera_end"
ENV{ID_PATH_TAG}=="*usb-0_1_3_1_0", SYMLINK+="videoc", GOTO="aos_camera_end"
ENV{ID_PATH_TAG}=="*usb-0_1_4_1_0", SYMLINK+="videod", GOTO="aos_camera_end"

# These are alternative four-port hub layouts; use one layout at a time.
# Unknown layouts need an explicit port mapping and calibration verification.

LABEL="aos_camera_end"
